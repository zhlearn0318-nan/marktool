# ExifTool 自定义配置：定义 aigc 命名空间，用于写国标 AIGC 隐式标识
# 与团队已验证的 exif实践/exiftool_aigc.config 保持一致
# 用法: exiftool -config exiftool_aigc.config -XMP-aigc:AIGC='{...}' 文件
%Image::ExifTool::UserDefined = (
    'Image::ExifTool::XMP::Main' => {
        aigc => {
            SubDirectory => {
                TagTable => 'Image::ExifTool::UserDefined::aigc',
            },
        },
    },
);

%Image::ExifTool::UserDefined::aigc = (
    GROUPS   => { 0 => 'XMP', 1 => 'XMP-aigc', 2 => 'Image' },
    NAMESPACE => { 'aigc' => 'http://example.com/aigc#', },
    AIGC     => { Writable => 'string', Avoid => 1 },
);

1; # 必须返回真值
