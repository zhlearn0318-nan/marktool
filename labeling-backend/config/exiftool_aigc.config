# ExifTool 自定义配置：定义 aigc 命名空间，用于写/读国标 AIGC 隐式标识
#
# 本文件是图片（JPEG/PNG）与视频（MP4）共用的唯一一份配置，由两条交付线合并而来：
#   · 命名空间取团队原始 config 的 http://example.com/aigc#（视频写入 + 已打标文件
#     都是这个值），不采用图片模块开发者自己改的 http://aigc-compliance/ns/1.0/
#   · AIGC 标签来自原始 config
#   · metadata 标签来自图片模块：其读取/移除路径会同时查询
#     `-XMP-aigc:AIGC` 与 `-XMP-aigc:metadata` 两个属性名。
#     若此处不定义 metadata，ExifTool 会以“标签未定义”告警并非零退出，
#     导致交叉读取判定为不可用，进而永久锁死自动修复通道。
#
# 用法: exiftool -config exiftool_aigc.config -XMP-aigc:AIGC='{...}' 文件
%Image::ExifTool::UserDefined = (
    'Image::ExifTool::XMP::Main' => {
        aigc => {
            SubDirectory => {
                TagTable => 'Image::ExifTool::UserDefined::aigc',
            },
        },
    },
);

%Image::ExifTool::UserDefined::aigc = (
    GROUPS   => { 0 => 'XMP', 1 => 'XMP-aigc', 2 => 'Image' },
    NAMESPACE => { 'aigc' => 'http://example.com/aigc#', },
    WRITABLE => 'string',
    AIGC     => { Name => 'AIGC' },
    metadata => { Name => 'metadata' },
);

require Image::ExifTool::XMP;
Image::ExifTool::XMP::RegisterNamespace(
    \%Image::ExifTool::UserDefined::aigc
);

1; # 必须返回真值
